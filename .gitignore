# Ignore everything by default; whitelist only source / text project files below.
# (Requires un-ignored dirs so Git can apply nested rules — see gitignore(5).)
**
!**/

# --- Python ---
!**/*.py
!**/*.pyi

# --- Notebooks (often code + outputs; strip outputs before commit if needed) ---
!**/*.ipynb

# --- Docs & prose ---
!**/*.md
!**/*.rst

# --- Declarative config / deps lists ---
!**/*.toml
!**/*.yaml
!**/*.yml
!**/*.txt
!**/*.ini
!**/*.cfg

# --- Shell ---
!**/*.sh

# --- Root-only tooling files ---
!.gitignore
!.gitattributes
!.editorconfig

# --- Extensionless files sometimes tracked ---
!**/Makefile
!**/Makefile.*
!**/Dockerfile
!**/Dockerfile.*
!**/LICENSE
!**/LICENSE.*

# Uncomment if you add native code:
# !**/*.c
# !**/*.h
# !**/*.cpp
# !**/*.rs

# ------------------------------------------------------------------------------
# Override: keep data / checkpoints / caches out of the repo (even under !**/).
# ------------------------------------------------------------------------------
.cache/
.claude/
checkpoints/
figures/
__pycache__/
*.egg-info/

# Binaries, media, datasets, exports
*.pdf
*.npz
*.npy
*.pt
*.pth
*.pth.tar
*.onnx
*.mp4
*.mov
*.avi
*.mkv
*.task
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.bmp
*.woff
*.woff2
*.ttf
*.eot
*.otf
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.sqlite
*.db
*.bin

# ------------------------------------------------------------------------------
# Dataset/: track contents here (overrides global binary rules above).
# Use directory negations so Git traverses the tree; then per-extension ! rules.
# MP4 stays ignored (no !…/*.mp4); explicit rule at end reinforces that.
# ------------------------------------------------------------------------------
!Dataset/
!Dataset/**/

!Dataset/**/*.pdf
!Dataset/**/*.npz
!Dataset/**/*.npy
!Dataset/**/*.pt
!Dataset/**/*.pth
!Dataset/**/*.pth.tar
!Dataset/**/*.onnx
!Dataset/**/*.mov
!Dataset/**/*.avi
!Dataset/**/*.mkv
!Dataset/**/*.task
!Dataset/**/*.zip
!Dataset/**/*.tar
!Dataset/**/*.tar.gz
!Dataset/**/*.tgz
!Dataset/**/*.7z
!Dataset/**/*.rar
!Dataset/**/*.png
!Dataset/**/*.jpg
!Dataset/**/*.jpeg
!Dataset/**/*.gif
!Dataset/**/*.webp
!Dataset/**/*.svg
!Dataset/**/*.ico
!Dataset/**/*.bmp
!Dataset/**/*.woff
!Dataset/**/*.woff2
!Dataset/**/*.ttf
!Dataset/**/*.eot
!Dataset/**/*.otf
!Dataset/**/*.csv
!Dataset/**/*.tsv
!Dataset/**/*.parquet
!Dataset/**/*.feather
!Dataset/**/*.h5
!Dataset/**/*.hdf5
!Dataset/**/*.pkl
!Dataset/**/*.pickle
!Dataset/**/*.joblib
!Dataset/**/*.sqlite
!Dataset/**/*.db
!Dataset/**/*.bin

# Common annotation / metadata not covered by root whitelist
!Dataset/**/*.json
!Dataset/**/*.xlsx

# Any other path under Dataset/ (then exclude mp4 explicitly below)
!Dataset/**/*
Dataset/**/*.mp4
